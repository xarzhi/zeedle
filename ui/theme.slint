// Zeedle Custom Theme — Fluent-inspired
// Two complete palettes: light (is-dark = false) and dark (is-dark = true)
import { Palette } from "std-widgets.slint";

export global Theme {
    in-out property <bool> is-dark;

    // Panel background — sidebar, title bar
    // out property <color> panel: is-dark ? #2D2D30 : #F3F3F3;
    out property <color> panel: is-dark ? Palette.background.brighter(0.40) : Palette.background.darker(0.02);
    // Content surface — main area, cards, controls
    // out property <color> surface: is-dark ? #1E1E1E : #FFFFFF;
    out property <color> surface: is-dark ? Palette.background.darker(0.40) : Palette.background.brighter(1.);
    // Hover state — items, buttons
    // out property <color> hover: is-dark ? #3C3C3F : #EAEAEA;
    out property <color> hover: is-dark ? Palette.background.brighter(0.80) : Palette.background.darker(0.04);
    // Song list hover — softer contrast than general hover
    // out property <color> song-hover: is-dark ? #2A2A2C : #FAFAFA;
    out property <color> song-hover: is-dark ? Palette.background.brighter(0.10) : Palette.background;
    // Pressed state — items, buttons
    // out property <color> press: is-dark ? #4A4A4D : #D6D6D6;
    out property <color> press: is-dark ? Palette.background.brighter(0.70) : Palette.background.darker(0.04);

    // === Text ===
    // out property <color> text: is-dark ? #FFFFFF : #1A1A1A;
    out property <color> text: is-dark ? Palette.foreground : Palette.foreground;
    // out property <color> text-secondary: is-dark ? #9D9D9D : #666666;
    out property <color> text-secondary: is-dark ? Palette.foreground.darker(0.3) : Palette.foreground.brighter(0.3);
    // out property <color> text-tertiary: is-dark ? #6E6E6E : #999999;
    out property <color> text-tertiary: is-dark ? Palette.foreground.darker(0.3) : Palette.background.darker(0.7);

    // === Borders & Dividers ===
    // out property <color> border: is-dark ? #3E3E42 : #E0E0E0;
    out property <color> border: is-dark ? Palette.background.brighter(1.5) : Palette.background.darker(0.1);
    // out property <color> divider: is-dark ? #38383A : #EBEBEB;
    out property <color> divider: is-dark ? Palette.background.brighter(1.5) : Palette.background.darker(0.1);

    // === Accent (Fluent blue) ===
    // out property <color> accent: is-dark ? #60CDFF : #005FB8;
    out property <color> accent: is-dark ? Palette.accent-background : Palette.accent-background;
}
